// Prose in this repo wraps at 80 columns, and a hard tab in prose is an error.
// Three exemptions, each for content that cannot be reflowed without damaging
// it. Everything else stays enforced.
{
  "MD013": {
    // Code blocks are verbatim: a fence is quoted from, or written into, a
    // real file. The fisher bootstrap URL in INSTALL.md is past 80 characters
    // on its own, which leaves no room for a continuation.
    "code_blocks": false,
    // A markdown table row cannot wrap. The design document's measurement
    // tables carry cells well past 80 characters.
    "tables": false
  },
  "MD010": {
    // Every hard tab is inside a code block: shell quoted from bin/, and
    // gitconfig snippets that have to match a file this repo indents with
    // tabs throughout.
    "code_blocks": false
  }
}
