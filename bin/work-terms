#!/usr/bin/env bash
# consus/bin/work-terms — keeps work terms out of this public repo. See
# README.md, "Secret scanning".
#
# As lefthook's guards (lefthook.yml), over the whole repo:
#   check-msg FILE     commit-msg: the message in FILE
#   check-staged       pre-commit: the lines the staged diff adds
#   check-push REMOTE  pre-push: the ref names, tag messages (each tag's, when
#                      one tag points at another), commit messages and added
#                      lines being pushed, from git's ref lines on stdin
# And by hand:
#   check              stdin: fail if it names a work term
#
# Exit 0 passes, 1 refuses, 2 is a usage error. The term list is
# .git/info/terms.tsv in this clone — outside the working tree, so git can
# neither stage nor clean it — and WORK_TERMS overrides it. Without it every
# guard refuses everything, on purpose. It holds one guard row (an extended
# regex, matched in any case), at most one guard_cs row (matched as written),
# and term rows, each a literal matched as a whole word:
#   guard<TAB><regex>
#   guard_cs<TAB><regex>
#   term<TAB><literal>
set -uo pipefail
export LC_ALL=C PATH=$PATH:/opt/homebrew/bin
if [ -n "${WORK_TERMS:-}" ]; then
	terms=$WORK_TERMS
elif gitdir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
	terms=$gitdir/info/terms.tsv
else
	terms=
fi

fail() { echo "work-terms: $*" >&2; exit 1; }
usage() { echo "usage: work-terms $*" >&2; exit 2; }

# check's buffer holds raw input — the staged diff, the pushed commits — so
# every way out removes it, an interrupt included. check re-arms the traps: it
# often runs as a pipeline's last command, in a subshell, where bash resets
# them.
buf=
cleanup() { [ -z "$buf" ] || rm -f -- "$buf"; }
arm() { trap cleanup EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; }
arm

# Fails when stdin names a work term; prints each hit.
check() {
	local kind rx ci= cs= nci=0 ncs=0 hits
	arm
	buf=$(mktemp "${TMPDIR:-/tmp}/work-terms.XXXXXX") || exit 1
	cat > "$buf"
	[ -n "$terms" ] || fail "not in a git clone and WORK_TERMS is unset, refusing to pass anything"
	[ -r "$terms" ] || fail "can't read $terms, refusing to pass anything"
	while IFS=$'\t' read -r kind rx || [ -n "$kind" ]; do
		case $kind in
		guard) ci=$rx nci=$((nci + 1)) ;;
		guard_cs) cs=$rx ncs=$((ncs + 1)) ;;
		esac
	done < "$terms"
	[ -n "$ci" ] || fail "no guard row in $terms, refusing to pass anything"
	# Only the last row of each kind would count, and nothing would say so.
	[ "$nci" -eq 1 ] || fail "$terms has $nci guard rows; join them with | into one"
	[ "$ncs" -le 1 ] || fail "$terms has $ncs guard_cs rows; join them with | into one"
	# grep exits 2 on a regex it cannot compile and matches nothing, which would
	# pass everything: each guard must compile first.
	for rx in "$ci" "$cs"; do
		[ -n "$rx" ] || continue
		grep -E -e "$rx" /dev/null 2>/dev/null
		[ $? -eq 1 ] || fail "a guard row in $terms is not a valid extended regex, refusing to pass anything"
	done
	hits=$({ grep -a -n -o -i -E "$ci" "$buf"
		[ -z "$cs" ] || grep -a -n -o -E "$cs" "$buf"
		awk -F '\t' '$1 == "term" && NF == 2 && $2 != "" { print $2 }' "$terms" | grep -a -n -o -w -F -f - "$buf"
	} | sort -u -t : -k 1n -k 2)
	rm -f "$buf"
	buf=
	[ -z "$hits" ] || fail "work term(s) found; keep them in a work repo:
$hits"
}

# Keeps added lines and file headers; a diff with nothing added is not an error.
added_lines() { grep -a -E '^(\+|diff --git )' || [ $? -eq 1 ]; }

# Prints the tag at $1 and every tag it points at in turn, as git cat-file
# shows each, stopping at the first object that is not a tag: a neutral tag can
# point at one whose message names a term. Nothing nests tags this deep by
# accident, so a chain past 20 is refused, not read to its end.
tag_chain() {
	local obj=$1 txt n=0
	while [ "$(git cat-file -t "$obj" 2>/dev/null)" = tag ]; do
		[ "$n" -lt 20 ] || { echo "work-terms: a tag chain is more than 20 tags deep, refusing" >&2; return 1; }
		txt=$(git cat-file tag "$obj") || return 1
		printf '%s\n' "$txt"
		# A tag's first line is "object <sha>".
		obj=${txt%%$'\n'*}
		obj=${obj#object }
		n=$((n + 1))
	done
}

case ${1:-} in
	check) check ;;
	check-msg)
		[ -n "${2:-}" ] || usage "check-msg FILE"
		check < "$2"
		;;
	# The guards parse porcelain diffs, which user config can reshape: colour
	# codes break the ^+ match, and an external diff or a textconv driver can
	# print anything. --no-color, --no-ext-diff and --no-textconv turn all
	# three off, whatever the config says; check-push passes them too.
	check-staged) git diff --cached --no-color --no-ext-diff --no-textconv -U0 --no-renames --text | added_lines | check ;;
	check-push)
		[ -n "${2:-}" ] || usage "check-push REMOTE"
		remote=$2
		# What the remote already holds is left out only when $2 is one of this
		# clone's remotes and plain: --remotes=<name> is a pattern, so a remote
		# git config named * (or u*, u[p]*) would leave out every remote's refs,
		# a private remote's included. Otherwise, as for a URL, the whole history
		# of each pushed ref is scanned. Mirrors .lefthook/pre-push/gitleaks.sh.
		not=--not
		case $remote in
		*[[:space:]]* | *[][*?\\]*) not= ;;
		*) git remote | grep -qxF -- "$remote" || not= ;;
		esac
		# A deletion publishes nothing, so it is skipped: refusing it would keep
		# a leaked branch name on the remote. --root shows a root commit's diff,
		# which log.showRoot=false would hide on a push to an empty remote.
		while read -r lref sha rref _; do
			[ "$sha" = 0000000000000000000000000000000000000000 ] && continue
			{ printf '%s\n' "$lref" "$rref"
				tag_chain "$sha" || exit 1
				# Unquoted on purpose: two words or none; $remote holds no space or
				# glob character when $not is set.
				git log --format=%B "$sha" ${not:+--not --remotes="$remote"}
				git log -p --root --no-color --no-ext-diff --no-textconv -U0 --no-renames --text --diff-merges=first-parent --format= "$sha" ${not:+--not --remotes="$remote"} | added_lines
			} | check || exit 1
		done
		;;
	*) usage "check|check-msg FILE|check-staged|check-push REMOTE" ;;
esac
