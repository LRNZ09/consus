#!/usr/bin/env bash
# consus/bin/test-deny-rules — replays configs/claude/deny-corpus.tsv through an
# offline replica of how Claude Code matches Bash(...) deny rules, against the
# rules in settings.json. See configs/claude/README.md, "Hook-bypass deny
# rules".
#
# Each corpus row holds a command, its right answer and the answer Claude
# Code's own matcher gave when the command was last probed live. The test
# passes when the replica predicts the measured answer for every row: a change
# to the rules that moves any verdict fails it until the row is probed again
# and its measured answer updated. The rows whose measured answer is not the
# right one are the known gaps; they are counted, never failed.
#
# A full run also checks that the corpus holds every rule: each Bash deny rule
# must be the only rule that refuses some row, so that deleting it moves that
# row's verdict and fails the test. deny-exempt.tsv, next to the corpus, lists
# the exceptions, each with its reason: a redundant rule, which some row must
# still reach, and an older rule against destructive commands, which the
# corpus does not target. A listed rule missing from the rules fails the run
# too, so deleting one of those is caught as well. And the corpus header's
# "# cases: N" must be the number of rows the corpus holds.
#
# Nothing in the corpus ever runs. zsh's ${(z)} lexer splits each command
# (lexing only: no expansion), a small scanner finds the bodies of $( ), ` `,
# <( ) and >( ), and the rules are matched as text. A self-check lexes command
# substitutions that would create files, and fails if any file appears. Needs
# zsh and jq; no network.
#
# Usage: bin/test-deny-rules [--settings FILE] [--probe DIR] [--predict]
#                            [--gaps] [--rules] [-v] [ID...]
#   --settings FILE  the rules: permissions.deny in FILE; by default this
#                    clone's configs/claude/settings.json, which
#                    ~/.claude/settings.json links to. Nothing else in the
#                    file is read.
#   --probe DIR      the path <P> stands for in a command (default /tmp/probe)
#   --predict        print id<TAB>deny|allow, the replica's answer, for every
#                    row, and no verdicts
#   --gaps           list the known gaps too
#   --rules          list every rule, with how many rows it refuses and the
#                    rows no other rule refuses
#   -v               list every row, with the texts the rules are matched to
#   ID...            replay only these rows, with no coverage check
# Exit 0 when every prediction is the measured answer and every rule is
# covered; 1 when a prediction is not the measured answer, a rule is not
# covered, or no row was replayed; 64 for a bad argument or an ID no row has;
# 65 for a malformed corpus or exemption line, or a wrong case count.
#
# The replica, measured against Claude Code 2.1.273 by live probes on
# 2026-09-25 (docs: code.claude.com/docs/en/permissions):
#   - a command is split at && || ; | |& & and newlines, and ( ), { },
#     control-flow bodies, $( ), ` `, <( ) and >( ) hold commands of their
#     own; each simple command is matched on its own
#   - the text is matched as typed, then again after each leading wrapper is
#     stripped: timeout, time, nice, nohup, stdbuf, command, builtin, noglob,
#     bare xargs, and also env, sudo, doas, exec, setsid and nocorrect; after a
#     wrapper a dequoted copy is matched too; all leading NAME=value words go
#     at once (FOO=1 LEFTHOOK=0 BAR=2 git … reduces to git …, so LEFTHOOK=0 *
#     does not match it); a quoted program name is dequoted
#   - a heredoc (<< <<-) drops its operator, delimiter and body; a here-string
#     (<<<) keeps its text; a file redirection (> >> < 2>&1 …) drops itself and
#     every word after it in the simple command
#   - a rule's * is any text, empty and newlines included, quotes too; the
#     rule matches the whole text; blank runs count as one space; a trailing
#     " *" also matches the bare command, but only when it is the rule's only *
#   - the whole command line is matched too, but only for a cd-compound (a cd,
#     pushd, popd or chdir among the simple commands of a line that also has an
#     operator); that text starts with cd, so only a rule that starts with *
#     can match it
#   - `xargs RULE` matches
# When the matcher changes, live probes are the ground truth: probe, record the
# answer in the corpus, then fix the replica until it agrees.
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CORPUS=$ROOT/configs/claude/deny-corpus.tsv
EXEMPT=$ROOT/configs/claude/deny-exempt.tsv
SETTINGS=$ROOT/configs/claude/settings.json
PROBE=/tmp/probe
PREDICT=0 GAPS=0 RULES=0 VERBOSE=0
ONLY=()
usage() { echo "usage: bin/test-deny-rules [--settings FILE] [--probe DIR] [--predict] [--gaps] [--rules] [-v] [ID...]" >&2; exit 64; }
while [ $# -gt 0 ]; do
	case $1 in
	--settings) [ $# -ge 2 ] || usage; SETTINGS=$2; shift ;;
	--settings=*) SETTINGS=${1#*=} ;;
	--probe) [ $# -ge 2 ] || usage; PROBE=$2; shift ;;
	--probe=*) PROBE=${1#*=} ;;
	--predict) PREDICT=1 ;;
	--gaps) GAPS=1 ;;
	--rules) RULES=1 ;;
	-v) VERBOSE=1 ;;
	-h | --help) sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
	-*) echo "unknown option: $1" >&2; usage ;;
	*) ONLY+=("$1") ;;
	esac
	shift
done
command -v jq > /dev/null && command -v zsh > /dev/null || { echo "needs jq and zsh" >&2; exit 69; }
[ -r "$CORPUS" ] || { echo "no corpus at $CORPUS" >&2; exit 66; }
[ -r "$EXEMPT" ] || { echo "no exemption list at $EXEMPT" >&2; exit 66; }
[ -r "$SETTINGS" ] || { echo "no settings at $SETTINGS" >&2; exit 66; }

# --- The lexer: zsh -f, reading the command from $RC_CMD, never evaluating it.
# Prints every candidate text, NUL-terminated.
read -r -d '' ZSH_SRC << 'ZSH' || true
setopt extendedglob no_nomatch
redir='[0-9]#(&|)[<>][<>&|!-]#'           # a redirection operator, as (z) splits it
assign='[A-Za-z_][A-Za-z0-9_]#(|+)=*'     # NAME=value, NAME+=value
KEYWORDS=( if then elif else fi while until do done '!' '{' '}' esac coproc )
typeset -ga CANDS SUBS
typeset -gi DEPTH=0

emit() {
	local t=${1//[[:blank:]]##/ }
	t=${${t##[[:space:]]#}%%[[:space:]]#}
	[[ -n $t ]] || return 0
	(( ${CANDS[(Ie)$t]} )) && return 0
	CANDS+=( "$t" )
}

# Remove heredoc bodies from $1 (the lexer would read their lines as
# commands): REPLY is the code without them. No body is ever matched.
strip_heredocs() {
	local line l tail= i n=0 seen=0
	local -a pend w
	REPLY=
	for line in "${(@f)1}"; do
		if (( $#pend )); then
			l=$line
			[[ $pend[1] == t:* ]] && l=${l##$'\t'#}
			[[ $l == "${pend[1]#?:}" ]] && shift pend
			continue
		fi
		REPLY+=$line$'\n' tail+=$line$'\n'
		[[ $line == *'<<'* ]] || continue
		w=( ${(Z+C+)tail} ) n=0
		for (( i = 1; i < $#w; i++ )); do
			[[ $w[i] == ('<<'|'<<-') ]] || continue
			(( ++n > seen )) || continue
			[[ $w[i] == '<<-' ]] && pend+=( "t:${(Q)w[i+1]}" ) || pend+=( "d:${(Q)w[i+1]}" )
		done
		seen=$n
		(( $#pend )) && tail= seen=0
	done
	return 0
}

skip_bq() {  # $1 text, $2 index of an opening backtick: REPLY = index of the closing one
	local s=$1
	local -i j=$(( $2 + 1 )) n=${#1}
	while (( j <= n )) && [[ $s[j] != '`' ]]; do [[ $s[j] == '\' ]] && (( j++ )); (( j++ )); done
	REPLY=$j
}
ansi_end() {  # $1 text, $2 index just after $': REPLY = index of the closing quote
	local s=$1
	local -i j=$2 n=${#1}
	while (( j <= n )) && [[ $s[j] != "'" ]]; do [[ $s[j] == '\' ]] && (( j++ )); (( j++ )); done
	REPLY=$j
}

# $1 text, $2 index just after an opening "(": REPLY = index of the ")" that
# closes it (length+1 if none). Knows quotes, nesting, comments and heredocs.
close_at() {
	local s=$1 c l d
	local -i n=${#1} i=$2 depth=1 sq=0 dq=0 ts e
	local -a pend
	while (( i <= n )); do
		c=$s[i]
		if (( sq )); then [[ $c == "'" ]] && sq=0; (( i++ )); continue; fi
		if (( dq )); then
			case $c in
			('\') (( i++ )) ;;
			('"') dq=0 ;;
			('`') skip_bq "$s" $i; i=$REPLY ;;
			('$') if [[ $s[i+1] == '(' ]]; then close_at "$s" $(( i + 2 )); i=$REPLY; fi ;;
			esac
			(( i++ )); continue
		fi
		case $c in
		('\') (( i++ )) ;;
		("'") if [[ $s[i-1] == '$' ]]; then ansi_end "$s" $(( i + 1 )); i=$REPLY; else sq=1; fi ;;
		('"') dq=1 ;;
		('`') skip_bq "$s" $i; i=$REPLY ;;
		('(') (( depth++ )) ;;
		(')') (( --depth )) || { REPLY=$i; return 0; } ;;
		('#')
			if (( i == $2 )) || [[ $s[i-1] == [[:space:]\;\&\|\(] ]]; then
				while (( i < n )) && [[ $s[i+1] != $'\n' ]]; do (( i++ )); done
			fi ;;
		('<')
			if [[ $s[i+1] == '<' && $s[i+2] != '<' ]]; then
				(( i += 2 )); ts=0
				[[ $s[i] == - ]] && { ts=1; (( i++ )); }
				while [[ $s[i] == [[:blank:]] ]]; do (( i++ )); done
				d=
				while (( i <= n )) && [[ $s[i] != [[:space:]\;\&\|\(\)\<\>] ]]; do d+=$s[i]; (( i++ )); done
				(( i-- ))
				d=${d//[\'\"\\]/}
				[[ -n $d ]] && pend+=( "$ts:$d" )
			fi ;;
		($'\n')
			while (( $#pend && i < n )); do     # skip the heredoc bodies that start here
				e=$(( i + 1 ))
				while (( e <= n )) && [[ $s[e] != $'\n' ]]; do (( e++ )); done
				l=$s[i+1,e-1]
				[[ $pend[1] == 1:* ]] && l=${l##$'\t'#}
				[[ $l == "${pend[1]#?:}" ]] && shift pend
				i=$e
			done ;;
		esac
		(( i++ ))
	done
	REPLY=$(( n + 1 ))
}

# SUBS = the bodies of $( ), ` `, <( ) and >( ) in the word $1, one level deep.
subs_of() {
	local s=$1 c
	local -i n=${#1} i=1 sq=0 dq=0 st
	SUBS=()
	while (( i <= n )); do
		c=$s[i]
		if (( sq )); then [[ $c == "'" ]] && sq=0; (( i++ )); continue; fi
		case $c in
		('\') (( i++ )) ;;
		("'") if (( ! dq )); then if [[ $s[i-1] == '$' ]]; then ansi_end "$s" $(( i + 1 )); i=$REPLY; else sq=1; fi; fi ;;
		('"') (( dq = ! dq )) ;;
		('`') st=$i; skip_bq "$s" $i; i=$REPLY; SUBS+=( "$s[st+1,i-1]" ) ;;
		('$'|'<'|'>')
			if [[ $s[i+1] == '(' ]] && { [[ $c == '$' ]] || (( ! dq )); }; then
				if [[ $c == '$' && $s[i+2] == '(' ]]; then   # $(( arithmetic ))
					close_at "$s" $(( i + 2 )); i=$REPLY
				else
					st=$(( i + 2 )); close_at "$s" $st; i=$REPLY; SUBS+=( "$s[st,i-1]" )
				fi
			fi ;;
		esac
		(( i++ ))
	done
}

# The wrappers stripped before matching. Works on the caller's array w;
# returns 0 when it stripped one.
is_dur() { [[ $1 == [0-9]##(|.[0-9]##)(|[smhd]) ]] }
strip_wrapper() {
	local -i j=2
	case $w[1] in
	(time|nohup) [[ $w[j] == -- ]] && (( j++ )) ;;
	(timeout)
		while (( j <= $#w )); do
			case $w[j] in
			(--foreground|--preserve-status|--verbose|-v) (( j++ )) ;;
			(--kill-after=[A-Za-z0-9_.+-]##|--signal=[A-Za-z0-9_.+-]##|-[ks][A-Za-z0-9_.+-]##) (( j++ )) ;;
			(--kill-after|--signal|-k|-s) [[ $w[j+1] == [A-Za-z0-9_.+-]## ]] || return 1; (( j += 2 )) ;;
			(--) (( j++ )); break ;;
			(-*) return 1 ;;
			(*) break ;;
			esac
		done
		is_dur "$w[j]" || return 1
		(( j++ )) ;;
	(nice)
		if [[ $w[2] == -n && $w[3] == (|-)[0-9]## ]]; then j=4
		elif [[ $w[2] == -[0-9]## ]]; then j=3; fi
		[[ $w[j] == -- ]] && (( j++ )) ;;
	(stdbuf)
		while [[ $w[j] == -[ioe][LN0-9]## ]]; do (( j++ )); done
		(( j > 2 )) || return 1
		[[ $w[j] == -- ]] && (( j++ )) ;;
	(command)
		while [[ $w[j] == -p## ]]; do (( j++ )); done
		[[ $w[j] == -- ]] && (( j++ ))
		[[ $w[j] == -* ]] && return 1 ;;
	(builtin) [[ $w[j] == -- ]] && (( j++ )); [[ $w[j] == -* ]] && return 1 ;;
	(noglob|xargs) [[ $w[j] == -* ]] && return 1 ;;
	(*) strip_wrapper_more; return ;;
	esac
	(( j <= $#w )) || return 1
	w=( "${(@)w[j,-1]}" )
}
# The wrappers the documentation says are not stripped, and are.
strip_wrapper_more() {
	local a=${(Q)w[1]} t v
	local -a vopts
	local -i j=2
	case $a in
	(env) vopts=( -u -C --unset --chdir ) ;;
	(sudo) vopts=( -u -g -U -C -D -h -p -r -R -t -T -a --user --group --other-user --close-from
		--chdir --host --prompt --role --chroot --type --command-timeout --auth-type ) ;;
	(doas) vopts=( -a -u -C ) ;;
	(exec) vopts=( -a ) ;;
	(setsid|nocorrect) vopts=() ;;
	(*) return 1 ;;
	esac
	while (( j <= $#w )); do
		t=${(Q)w[j]}
		[[ $t == -- ]] && { (( j++ )); break; }
		if [[ $a == env && $t == (-S|--split-string|-S?*|--split-string=*) ]]; then
			case $t in
			(-S|--split-string) v=${(Q)w[j+1]}; (( j += 2 )) ;;
			(--split-string=*) v=${t#*=}; (( j++ )) ;;
			(*) v=${t#-S}; (( j++ )) ;;
			esac
			w=( ${=v} "${(@)w[j,-1]}" )
			return 0
		fi
		if [[ $t == -* ]]; then
			if (( ${vopts[(Ie)$t]} && j < $#w )); then (( j += 2 )); else (( j++ )); fi
			continue
		fi
		[[ $a == env && $t == $~assign ]] && { (( j++ )); continue; }
		break
	done
	(( j <= $#w )) || return 1
	w=( "${(@)w[j,-1]}" )
}

# The candidate texts of one simple command, given as its lexer words.
cands_for() {
	local -a w keep
	local -i i wrapped=0 guard=0
	w=( "$@" )
	# A heredoc (<< <<-) drops its operator, delimiter and body: --no-verify
	# before <<'EOF' is matched as last. A here-string (<<<) keeps its operator
	# and word. A file redirection (> >> < 2>&1 …) drops itself and every word
	# after it: the -n in git commit -m x 2>&1 -n is never seen.
	for (( i = 1; i <= $#w; i++ )); do
		case $w[i] in
		('<<'|'<<-') (( i++ )); continue ;;
		('<<<') keep+=( "$w[i]" ); continue ;;
		esac
		[[ $w[i] == $~redir ]] && break
		keep+=( "$w[i]" )
	done
	w=( "${keep[@]}" )
	while (( $#w && guard++ < 64 )); do
		emit "${(j: :)w}"
		[[ ${(Q)w[1]} != $w[1] ]] && emit "${(Q)w[1]} ${(j: :)w[2,-1]}"
		(( wrapped )) && emit "${(j: :)${(@Q)w}}"
		if [[ $w[1] == $~assign ]]; then
			shift w
			while (( $#w )) && [[ $w[1] == $~assign ]]; do shift w; done   # all leading assignments go at once
			continue
		fi
		strip_wrapper || break
		wrapped=1
	done
}

# One simple command: its nested commands first, then its own candidates.
simple() {
	local -a w subs
	local s
	local -i i
	w=( "$@" )
	for (( i = 1; i <= $#w; i++ )); do
		(( i > 1 )) && [[ $w[i-1] == ('<<'|'<<-') ]] && continue   # a delimiter
		subs_of "$w[i]"; subs=( "${SUBS[@]}" )
		for s in "${subs[@]}"; do split_code "$s"; done
	done
	while (( $#w )) && (( ${KEYWORDS[(Ie)$w[1]]} )); do shift w; done
	(( $#w )) || return 0
	[[ $w[1] == (for|select|case|function) ]] && return 0
	cands_for "${w[@]}"
}

# Split a command line into simple commands.
split_code() {
	local t
	local -a w cur
	(( ++DEPTH > 24 )) && { (( DEPTH-- )); return 0; }
	strip_heredocs "$1"
	w=( ${(Z+C+)REPLY} )
	for t in "${w[@]}"; do
		case $t in
		(';'|'&&'|'||'|'|'|'|&'|'&'|'&|'|'&!'|';;'|';&'|';|'|'('|')'|'(('|'))')
			(( $#cur )) && simple "${cur[@]}"
			cur=() ;;
		(*) cur+=( "$t" ) ;;
		esac
	done
	(( $#cur )) && simple "${cur[@]}"
	(( DEPTH-- ))
	return 0
}

# The whole command line as one text, with the text-level strips.
whole() {
	strip_heredocs "$1"   # no heredoc body is part of the whole-line text either
	local s=${${REPLY##[[:space:]]#}%%[[:space:]]#} f tok
	local -a w lines
	local -i guard=0 before k
	while [[ -n $s ]] && (( guard++ < 32 )); do
		emit "$s"
		lines=( "${(@f)s}" ); lines=( "${(@)lines:#[[:blank:]]#\#*}" )
		(( $#lines )) && emit "${(F)lines}"
		w=( ${(z)s} ); f=$w[1]
		[[ ${(Q)f} != $f ]] && emit "${(Q)f}${s#"$f"}"
		if [[ $f == $~assign && $f != *[\$\`]* && $s == "$f"[[:blank:]]* ]]; then
			s=${${s#"$f"}##[[:blank:]]#}
			while w=( ${(z)s} ) && f=$w[1] && [[ $f == $~assign && $f != *[\$\`]* && $s == "$f"[[:blank:]]* ]]; do
				s=${${s#"$f"}##[[:blank:]]#}   # all leading assignments go at once
			done
			continue
		fi
		before=$#w
		strip_wrapper || break
		k=$(( before - $#w ))
		for tok in "${(@)${(z)s}[1,k]}"; do s=${${s#"$tok"}##[[:blank:]]#}; done
	done
}

# The whole line is matched only for a cd-compound: `git push -n && echo
# --no-verify` and `echo GIT_CONFIG_KEY_0 && echo hooksPath` both ran, while
# `cd <P> && echo GIT_CONFIG_KEY_0 && echo hooksPath` was refused.
is_cd_compound() {
	strip_heredocs "$1"
	local -a w
	local t base
	local -i has_op=0 has_cd=0 boundary=1
	w=( ${(Z+C+)REPLY} )
	for t in "${w[@]}"; do
		case $t in
		(';'|'&&'|'||'|'|'|'|&'|'&'|'&|'|'&!'|';;'|';&'|';|'|'('|')'|'(('|'))'|$'\n')
			has_op=1; boundary=1; continue ;;
		esac
		(( boundary )) || continue
		[[ $t == $~assign ]] && continue
		case $t in
		(if|then|elif|else|fi|while|until|do|done|'!'|'{'|'}'|for|select|case|esac|function|in) continue ;;
		(time|nohup|timeout|nice|stdbuf|command|builtin|noglob|xargs|env|sudo|doas|exec|setsid|nocorrect) continue ;;
		esac
		base=${${(Q)t}:t}
		[[ $base == (cd|pushd|popd|chdir) ]] && has_cd=1
		boundary=0
	done
	(( has_op && has_cd ))
}

is_cd_compound "$RC_CMD" && whole "$RC_CMD"
split_code "$RC_CMD"
(( $#CANDS )) && print -rN -- "${CANDS[@]}"
exit 0
ZSH

# --- The rules: every Bash(...) entry of permissions.deny.
collapse() { # blank runs to one space, trimmed
	local s=${1//$'\t'/ }
	while [[ $s == *'  '* ]]; do s=${s//  / }; done
	s=${s# }; s=${s% }
	REPLY=$s
}
glob_of() { # a bash pattern: unescaped * is any text, everything else literal
	local p=$1 out='' c nx
	local -i i n=${#1}
	STARS=0
	for ((i = 0; i < n; i++)); do
		c=${p:i:1}
		if [[ $c == '\' ]] && ((i + 1 < n)); then
			nx=${p:i+1:1}
			if [[ $nx == '*' || $nx == '\' ]]; then out+="\\$nx"; ((i++)); continue; fi
		fi
		if [[ $c == '*' ]]; then out+='*'; STARS=$((STARS + 1)); else out+="\\$c"; fi
	done
	REPLY=$out
}
R_TEXT=() R_KIND=() R_PAT=() R_GLOB=() R_BARE=()
while IFS= read -r rule; do
	case $rule in Bash\(*\)) ;; *) continue ;; esac
	collapse "${rule#Bash(}"; body=${REPLY%)}
	collapse "$body"; body=$REPLY
	R_TEXT+=("$rule")
	if [[ $body == ?*:\* ]]; then
		R_KIND+=(prefix) R_PAT+=("${body%:\*}") R_GLOB+=("") R_BARE+=("")
		continue
	fi
	glob_of "$body"; g=$REPLY stars=$STARS
	if ((stars == 0)); then
		R_KIND+=(exact) R_PAT+=("$body") R_GLOB+=("") R_BARE+=("")
		continue
	fi
	bare=
	if [[ $body == *' *' ]] && ((stars == 1)); then
		glob_of "${body% \*}"; bare=$REPLY
	fi
	R_KIND+=(wild) R_PAT+=("$body") R_GLOB+=("$g") R_BARE+=("$bare")
done < <(jq -r '.permissions.deny[]? | strings' "$SETTINGS")
NRULES=${#R_KIND[@]}
((NRULES > 0)) || { echo "no Bash deny rules in $SETTINGS" >&2; exit 65; }

# rule_hits INDEX TEXT. R_GLOB and R_BARE are patterns, unquoted on purpose.
# shellcheck disable=SC2053
rule_hits() {
	local i=$1 c=$2 x
	case ${R_KIND[i]} in
	exact) [[ $c == "${R_PAT[i]}" ]] ;;
	prefix)
		x=${R_PAT[i]}
		[[ $c == "$x" || $c == "$x "* || $c == "xargs $x" || $c == "xargs $x "* ]] ;;
	wild)
		[[ $c == ${R_GLOB[i]} ]] && return 0
		[[ -n ${R_BARE[i]} && $c == ${R_BARE[i]} ]] && return 0
		[[ $c == 'xargs '* ]] || return 1
		x=${c#xargs }
		[[ $x == ${R_GLOB[i]} ]] && return 0
		[[ -n ${R_BARE[i]} && $x == ${R_BARE[i]} ]] ;;
	*) return 1 ;;
	esac
}

# predict COMMAND: PRED=deny|allow, HITS=the index of every rule that refuses
# it, HIT=the first of them, HITC=the text it matched
predict() {
	local c
	local -i i
	PRED=allow HIT='' HITC=''
	HITS=() CANDS=()
	while IFS= read -r -d '' c; do CANDS+=("$c"); done < <(RC_CMD=$1 zsh -f -c "$ZSH_SRC")
	for ((i = 0; i < NRULES; i++)); do
		for c in ${CANDS[@]+"${CANDS[@]}"}; do
			rule_hits "$i" "$c" || continue
			HITS+=("$i")
			[ "$PRED" = deny ] || { PRED=deny HIT=${R_TEXT[i]} HITC=$c; }
			break
		done
	done
}
show() { printf '%s\n' "$1" | sed 's/^/        /'; }

# --- Self-check: substitutions that would create files, lexed only.
T=$(mktemp -d "${TMPDIR:-/tmp}/deny-rules.XXXXXX")
trap 'rm -rf "$T"' EXIT
for c in "echo \$(touch $T/c1) \`touch $T/c2\` <(touch $T/c3) >(touch $T/c4)" \
	"git commit -n -m \"x \$(touch $T/c5)\"" \
	"cat <<EOF"$'\n'"\$(touch $T/c6)"$'\n'"EOF" \
	"x=\$(cat <<'EOF'"$'\n'"\$(touch $T/c7)"$'\n'"EOF"$'\n'")" \
	"env -S 'touch $T/c8' true"; do
	predict "$c"
done
if [ -n "$(ls -A "$T")" ]; then
	echo "selfcheck FAIL: lexing a command ran part of it: $(ls -A "$T")" >&2
	exit 70
fi
((PREDICT)) || echo "selfcheck ok: lexing ran no part of 5 commands that would create files"

# --- The corpus
cases=0 agree=0 differ=0 through=0 refused=0 rows=0 declared=
SEENIDS=() GAPLIST=() FOUND=()
R_REACH=() R_SOLE=() R_SOLEIDS=()
for ((i = 0; i < NRULES; i++)); do R_REACH+=(0) R_SOLE+=(0) R_SOLEIDS+=(''); done
while IFS= read -r line || [ -n "$line" ]; do
	case $line in
	'# cases: '*)
		declared=${line#'# cases: '}
		[[ $declared =~ ^[1-9][0-9]*$ ]] || { echo "bad case count: $line" >&2; exit 65; }
		continue ;;
	'' | '#'*) continue ;;
	esac
	rows=$((rows + 1))
	id=${line%%$'\t'*} rest=${line#*$'\t'}
	right=${rest%%$'\t'*} rest=${rest#*$'\t'}
	measured=${rest%%$'\t'*} rest=${rest#*$'\t'}
	raw=${rest%%$'\t'*} why=${rest#*$'\t'}
	if [[ $line != *$'\t'*$'\t'*$'\t'*$'\t'* || ($right != deny && $right != allow) ||
		($measured != deny && $measured != allow) ]]; then
		echo "bad corpus line: $line" >&2; exit 65
	fi
	for s in ${SEENIDS[@]+"${SEENIDS[@]}"}; do
		[ "$s" = "$id" ] && { echo "duplicate id: $id" >&2; exit 65; }
	done
	SEENIDS+=("$id")
	t=${raw//\\\\/} t=${t//\\n/} t=${t//\\t/}
	[[ $t == *\\* ]] && { echo "$id: only \\n \\t \\\\ escapes are allowed" >&2; exit 65; }
	# A known gap is a row whose measured answer is not the right one, and
	# its why says so.
	gap=0 said=0
	[ "$right" = "$measured" ] || gap=1
	[[ $why == *'known gap'* ]] && said=1
	if [ "$gap" != "$said" ]; then
		if ((gap)); then
			echo "$id: its measured answer is not the right one, and its why does not say known gap" >&2
		else
			echo "$id: its why says known gap, but its measured answer is the right one" >&2
		fi
		exit 65
	fi
	if ((${#ONLY[@]})); then
		keep=0
		for s in "${ONLY[@]}"; do [ "$s" = "$id" ] && keep=1; done
		((keep)) || continue
		FOUND+=("$id")
	fi
	cmd=$(printf '%bx' "$raw") cmd=${cmd%x}
	cmd=${cmd//<P>/$PROBE}
	cases=$((cases + 1))
	predict "$cmd"
	for i in ${HITS[@]+"${HITS[@]}"}; do R_REACH[i]=$((R_REACH[i] + 1)); done
	if [ ${#HITS[@]} -eq 1 ]; then
		i=${HITS[0]}
		R_SOLE[i]=$((R_SOLE[i] + 1)) R_SOLEIDS[i]+=" $id"
	fi
	if ((PREDICT)); then
		printf '%s\t%s\n' "$id" "$PRED"
		continue
	fi
	if ((gap)); then
		differ=$((differ + 1))
		[ "$right" = deny ] && through=$((through + 1)) || refused=$((refused + 1))
		GAPLIST+=("$id: right $right, measured $measured ($why)")
	fi
	if [ "$PRED" = "$measured" ]; then
		agree=$((agree + 1))
		((VERBOSE)) && printf 'ok   %s\n' "$id"
	else
		printf 'FAIL %s: measured %s, the rules now %s (%s)\n' "$id" "$measured" "$PRED" "$why"
		show "$raw"
		[ "$PRED" = deny ] && printf '        rule %s matched: %s\n' "$HIT" "${HITC//$'\n'/\\n}"
	fi
	if ((VERBOSE)); then
		for c in ${CANDS[@]+"${CANDS[@]}"}; do printf '        | %s\n' "${c//$'\n'/\\n}"; done
	fi
done < "$CORPUS"
# A typo in an ID, or a lost or cut-short corpus, must not pass as 0 of 0.
bad=0
for s in ${ONLY[@]+"${ONLY[@]}"}; do
	seen=0
	for f in ${FOUND[@]+"${FOUND[@]}"}; do [ "$f" = "$s" ] && seen=1; done
	((seen)) || { echo "no row has the id $s" >&2; bad=1; }
done
((bad)) && exit 64
if [ -z "$declared" ]; then
	echo "the corpus header has no '# cases: N' line" >&2; exit 65
# As text: -ne errors on a count too large for an integer, and elif reads the
# error as false. The pattern above rules out leading zeros.
elif [ "$declared" != "$rows" ]; then
	echo "the corpus header says $declared cases, but the corpus holds $rows" >&2; exit 65
fi
((PREDICT)) && exit 0

# --- Coverage: each rule alone refuses some row, or deny-exempt.tsv says why
# not. Lines: rule<TAB>redundant|older<TAB>why.
X_RULE=() X_KIND=()
while IFS= read -r line || [ -n "$line" ]; do
	case $line in '' | '#'*) continue ;; esac
	rule=${line%%$'\t'*} rest=${line#*$'\t'}
	kind=${rest%%$'\t'*}
	if [[ $line != *$'\t'*$'\t'?* || $rule != Bash\(*\) || ($kind != redundant && $kind != older) ]]; then
		echo "bad exemption line: $line" >&2; exit 65
	fi
	for s in ${X_RULE[@]+"${X_RULE[@]}"}; do
		[ "$s" = "$rule" ] && { echo "exempted twice: $rule" >&2; exit 65; }
	done
	X_RULE+=("$rule") X_KIND+=("$kind")
done < "$EXEMPT"
uncovered=0 nred=0 nold=0 ncov=0
uncover() { printf 'UNCOVERED %s: %s\n' "$1" "$2"; uncovered=$((uncovered + 1)); }
for ((i = 0; i < NRULES; i++)); do
	kind=
	for ((j = 0; j < ${#X_RULE[@]}; j++)); do [ "${X_RULE[j]}" = "${R_TEXT[i]}" ] && kind=${X_KIND[j]}; done
	if ((RULES)); then
		printf 'rule %s: refuses %d rows, %d of them alone%s%s\n' "${R_TEXT[i]}" "${R_REACH[i]}" \
			"${R_SOLE[i]}" "${R_SOLEIDS[i]:+ (${R_SOLEIDS[i]# })}" "${kind:+; listed as $kind}"
	fi
	((${#ONLY[@]})) && continue
	case $kind in
	older) nold=$((nold + 1)) ;;
	redundant)
		nred=$((nred + 1))
		((R_REACH[i])) || uncover "${R_TEXT[i]}" "listed as redundant, but no row reaches it"
		((R_SOLE[i] == 0)) || uncover "${R_TEXT[i]}" "listed as redundant, but it alone refuses${R_SOLEIDS[i]}: take it off deny-exempt.tsv"
		;;
	*)
		if ((R_REACH[i] == 0)); then
			uncover "${R_TEXT[i]}" "no row reaches it: add a row, probed live, that it alone refuses"
		elif ((R_SOLE[i] == 0)); then
			uncover "${R_TEXT[i]}" "another rule refuses each row it refuses: add a row, probed live, that it alone refuses, or list it in deny-exempt.tsv as redundant"
		else
			ncov=$((ncov + 1))
		fi ;;
	esac
done
if ((${#ONLY[@]} == 0)); then
	for ((j = 0; j < ${#X_RULE[@]}; j++)); do
		held=0
		for ((i = 0; i < NRULES; i++)); do [ "${X_RULE[j]}" = "${R_TEXT[i]}" ] && held=1; done
		((held)) || uncover "${X_RULE[j]}" "deny-exempt.tsv lists it, but the rules do not hold it"
	done
fi

if ((GAPS)); then
	for g in ${GAPLIST[@]+"${GAPLIST[@]}"}; do printf 'gap  %s\n' "$g"; done
fi
echo "rules: $NRULES Bash deny rules from $SETTINGS"
echo "predicted as measured: $agree of $cases"
echo "known gaps, where the measured answer is not the right one: $differ" \
	"(let through: $through, refused though harmless: $refused)"
if ((${#ONLY[@]} == 0)); then
	echo "coverage: $ncov rules each alone refuse a row;" \
		"$nred listed as redundant, $nold older ones exempt; $uncovered uncovered"
fi
((cases > 0)) || { echo "no row was replayed" >&2; exit 1; }
[ "$agree" -eq "$cases" ] && [ "$uncovered" -eq 0 ]
