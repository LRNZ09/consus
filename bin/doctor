#!/bin/sh
# consus/bin/doctor — run the record's assertions against this machine.
# Exits 0 when they all hold. The assertions themselves, and why each one
# exists, are in doctor.bats next to this file.
set -eu
unset CDPATH
here=$(cd -- "$(dirname -- "$0")" && pwd -P)

if ! command -v bats >/dev/null 2>&1; then
	echo "✖ bats is not installed — run: brew install bats-core" >&2
	exit 1
fi

# --print-output-on-failure: without it a failing assertion reports only the
# line that returned non-zero, and every message explaining what to do about it
# is swallowed.
exec bats --print-output-on-failure "$here/doctor.bats"
